{
  "name": "bedrock-agentcore-ts",
  "version": "1.0.0",
  "description": "TypeScript implementation for AWS Bedrock AgentCore Runtime",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/examples/simple-agent.js",
    "dev": "ts-node src/examples/simple-agent.ts",
    "test": "npx ts-node src/test-connection.ts",
    "chat": "npx ts-node src/examples/interactive-cli.ts",
    "stream": "npx ts-node src/examples/streaming-agent.ts",
    "session": "npx ts-node src/examples/session-state-agent.ts",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "format": "prettier --write \"src/**/*.ts\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.md\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run format:check && npm run lint:check && npm run typecheck"
  },
  "keywords": [
    "aws",
    "bedrock",
    "agentcore",
    "ai",
    "agent",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.662.0",
    "@aws-sdk/credential-providers": "^3.662.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
