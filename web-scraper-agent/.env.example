# AWS Configuration
# Required: AWS region where Bedrock AgentCore is available
# Recommended regions: us-west-2, us-east-1
AWS_REGION=us-west-2

# Optional: AWS Profile name (if using named profiles)
# AWS_PROFILE=default

# Target Website Configuration
# Optional: Can be provided at runtime via interactive prompt
# If set here, the agent will automatically scrape this website
TARGET_WEBSITE=

# Example:
# TARGET_WEBSITE=https://example.com.au

# Agent Configuration (Optional - uses defaults if not set)
# BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# Logging Configuration (Optional)
# LOG_LEVEL=INFO
