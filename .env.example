# AWS Configuration
# ==================

# AWS Region where your Bedrock agent is deployed
AWS_REGION=us-east-1

# AWS Profile to use (optional, defaults to 'default')
# AWS_PROFILE=default

# AWS Credentials (not recommended for production - use IAM roles or profiles instead)
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key


# Bedrock Agent Configuration
# ============================

# Your Bedrock Agent ID (format: XXXXXXXXXX)
# Get this from AWS Console -> Bedrock -> Agents -> Select your agent
BEDROCK_AGENT_ID=YOUR_AGENT_ID

# Your Bedrock Agent Alias ID (format: YYYYYYYYYY)
# Get this from AWS Console -> Bedrock -> Agents -> Select your agent -> Aliases
BEDROCK_AGENT_ALIAS_ID=YOUR_AGENT_ALIAS_ID


# Optional Configuration
# ======================

# Enable trace logging for debugging (true/false)
# ENABLE_TRACE=false

# Custom session ID (optional - will be auto-generated if not provided)
# SESSION_ID=custom-session-id
